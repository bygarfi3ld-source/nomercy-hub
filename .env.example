# Copy this file to .env and set values in your terminal or hosting provider.
# Node.js does not automatically load .env unless started with --env-file=.env.
# NEVER commit actual passwords or admin tokens.
HOST=127.0.0.1
PORT=3030
DATA_DIR=./data
# Set NODE_ENV=production for hosting. Events remain publicly readable by default.
NODE_ENV=development
# Optional: set to 1 to require an extra shared password for the entire site.
SITE_PREVIEW_LOCK=0
TEST_ACCESS_USER=nomercy
TEST_ACCESS_PASSWORD=
# Optional: 24+ random chars for local moderation interface.
ADMIN_TOKEN=
# For HTTPS deployments behind Railway/reverse proxy.
COOKIE_SECURE=0
